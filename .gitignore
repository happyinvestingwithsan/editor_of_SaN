# ==========================================
# SaN Studio - 4-Zone Git Ignore Rules
# ==========================================

# 1. Ephemeral Workspace (Disposables never tracked in Git)
3_WORKSPACE/raw/*
3_WORKSPACE/proxies/*
3_WORKSPACE/audio/*
3_WORKSPACE/preview/*
!3_WORKSPACE/raw/.gitkeep
!3_WORKSPACE/proxies/.gitkeep
!3_WORKSPACE/audio/.gitkeep
!3_WORKSPACE/preview/.gitkeep

# 2. Large Media Binaries (Keep repo ultra-lean)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.flac
*.m4a
*.mp3
*.part

# 3. Dependencies & Package Managers
node_modules/
1_CORE/engine/node_modules/
npm-debug.log*
yarn-debug.log*
package-lock.json

# 4. Engine Build Outputs & Caches
.remotion/
.cache/
build/
dist/
out/
contact_frames/
1_CORE/engine/build/
1_CORE/engine/out/
1_CORE/engine/contact_frames/
1_CORE/engine/public/video/
1_CORE/engine/public/audio/

# 5. Output Large Video Deliverables (Paths kept in 4_OUTPUT/master_manifest.json)
4_OUTPUT/exports/*.mp4
4_OUTPUT/exports/*.mov

# 6. Python Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
ENV/
.pytest_cache/

# 7. OS & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# 8. Whitelist Core Assets, Tokens, Code & Manifests
!2_VAULT/brand_kits/**/*.json
!2_VAULT/brand_kits/**/*.ts
!2_VAULT/vault_index.json
!4_OUTPUT/master_manifest.json
!4_OUTPUT/projects/**/*.md
!4_OUTPUT/projects/**/*.json
!4_OUTPUT/projects/**/*.txt
